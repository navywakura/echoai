{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SIM-3 declarative world family v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "family_id", "prng", "lattice_mm", "archetypes"],
  "properties": {
    "schema_version": {"const": 1},
    "profile": {"const": "sim3-boxes-v1"},
    "family_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
    "prng": {"type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": {"name": {"const": "SplitMix64"}, "version": {"const": 1}}},
    "lattice_mm": {"const": 100},
    "archetypes": {"type": "object", "additionalProperties": false, "required": ["A", "B", "C"], "properties": {
      "A": {"$ref": "#/$defs/single"},
      "B": {"$ref": "#/$defs/staggered"},
      "C": {"$ref": "#/$defs/pocket"}
    }}
  },
  "$defs": {
    "range": {"type": "object", "additionalProperties": false, "required": ["lo", "hi", "step"], "properties": {"lo": {"type": "integer", "minimum": -8000, "maximum": 8000, "multipleOf": 100}, "hi": {"type": "integer", "minimum": -8000, "maximum": 8000, "multipleOf": 100}, "step": {"const": 100}}},
    "choices": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 100, "maximum": 8000, "multipleOf": 100}},
    "single": {"type": "object", "additionalProperties": false, "required": ["template", "thickness_choices_mm", "wall_x_mm", "half_length_mm", "height_mm", "station_x_mm", "station_y_mm", "spawn_x_mm", "spawn_y_mm"], "properties": {"template": {"const": "single_wall"}, "thickness_choices_mm": {"$ref": "#/$defs/choices"}, "wall_x_mm": {"$ref": "#/$defs/range"}, "half_length_mm": {"$ref": "#/$defs/range"}, "height_mm": {"$ref": "#/$defs/range"}, "station_x_mm": {"$ref": "#/$defs/range"}, "station_y_mm": {"$ref": "#/$defs/range"}, "spawn_x_mm": {"$ref": "#/$defs/range"}, "spawn_y_mm": {"$ref": "#/$defs/range"}}},
    "staggered": {"type": "object", "additionalProperties": false, "required": ["template", "thickness_choices_mm", "wall1_x_mm", "wall2_x_mm", "span1_mm", "span2_mm", "height1_mm", "height2_mm", "station_x_mm", "station_y_mm", "spawn_x_mm", "spawn_y_mm"], "properties": {"template": {"const": "staggered_walls"}, "thickness_choices_mm": {"$ref": "#/$defs/choices"}, "wall1_x_mm": {"$ref": "#/$defs/range"}, "wall2_x_mm": {"$ref": "#/$defs/range"}, "span1_mm": {"$ref": "#/$defs/range"}, "span2_mm": {"$ref": "#/$defs/range"}, "height1_mm": {"$ref": "#/$defs/range"}, "height2_mm": {"$ref": "#/$defs/range"}, "station_x_mm": {"$ref": "#/$defs/range"}, "station_y_mm": {"$ref": "#/$defs/range"}, "spawn_x_mm": {"$ref": "#/$defs/range"}, "spawn_y_mm": {"$ref": "#/$defs/range"}}},
    "pocket": {"type": "object", "additionalProperties": false, "required": ["template", "station_x_mm", "station_y_mm", "depth_mm", "half_width_mm", "height_mm", "thickness_choices_mm", "spawn_x_mm", "spawn_y_mm"], "properties": {"template": {"const": "three_sided_pocket"}, "station_x_mm": {"$ref": "#/$defs/range"}, "station_y_mm": {"$ref": "#/$defs/range"}, "depth_mm": {"$ref": "#/$defs/range"}, "half_width_mm": {"$ref": "#/$defs/range"}, "height_mm": {"$ref": "#/$defs/range"}, "thickness_choices_mm": {"$ref": "#/$defs/choices"}, "spawn_x_mm": {"$ref": "#/$defs/range"}, "spawn_y_mm": {"$ref": "#/$defs/range"}}}
  }
}
